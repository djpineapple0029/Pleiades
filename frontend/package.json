{
  "name": "atlasmap-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.viewer.config.js && node scripts/build-viewer.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --project=swiftshader",
    "test:e2e:headed": "playwright test --project=headed-lock",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.js",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
